# ============================================================
# Supabase (Cloud) — https://supabase.com/dashboard
# ============================================================
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API -> anon public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service Role key (server-only. NEVER expose in browser/client code)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ============================================================
# Google Drive (upload invoices to Drive folder)
# See Google_Cloud_Service_Account_Guide.md at project root
# ============================================================
# Full path to the service-account JSON key downloaded from Google Cloud
# (rename it to google-credentials.json and place it next to this file,
#  or set an absolute path). It is git-ignored.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=./google-credentials.json

# ID of the Drive folder named "Finance_Invoices" that you shared
# with the service account email (Editor). Find ID in folder URL:
# https://drive.google.com/drive/folders/<THIS-IS-THE-ID>
GOOGLE_DRIVE_INVOICE_FOLDER_ID=YOUR-DRIVE-FOLDER-ID

# Optional: full JSON string of the service account (alternative to file).
# Uncomment and paste the JSON on a single line if you don't use a file.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={...}
